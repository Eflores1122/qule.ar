# Copiá este archivo a .env (nunca subas .env al repo)

# Obligatoria en producción. Generala con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Login con Google (opcional). Redirección: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres real (opcional). Si no está, se usa PGlite en ./data
DATABASE_URL=

# URL pública de la web
APP_URL=http://localhost:5173
